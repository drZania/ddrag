APP_NAME=DDRAG
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://ddrag:ddrag_dev_password@127.0.0.1:55432/ddrag
JWT_SECRET=development-only-placeholder-change-this-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DOCUMENT_STORAGE_PATH=storage/documents
MAX_UPLOAD_SIZE_BYTES=10485760
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=200
CHUNKING_VERSION=ddrag-chunking-v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
GENERATION_MODEL=qwen2.5:1.5b
# Docker Desktop backend containers reach a host Ollama instance through this URL.
# Local non-containerized backend development can instead use http://127.0.0.1:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_DIMENSION=1024
RETRIEVAL_DEFAULT_TOP_K=5

# Docker Compose database settings only. Do not use these credentials in production.
POSTGRES_DB=ddrag
POSTGRES_USER=ddrag
POSTGRES_PASSWORD=ddrag_dev_password
